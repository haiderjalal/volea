# --- Required ---------------------------------------------------------------
# Supabase project hosting Volea. Without these the app builds but every page
# fails at request time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional ---------------------------------------------------------------
# Absolute origin for canonical URLs, Open Graph and the email-confirmation
# redirect. Leave it unset on Vercel and it falls back to
# VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL, then localhost.
#
# Set it explicitly once you have a custom domain — VERCEL_URL changes on every
# deployment, which would break confirmation links.
#
# Note: an EMPTY value is not the same as unset for most tooling, but
# src/lib/site.ts treats both as missing on purpose.
NEXT_PUBLIC_SITE_URL=

# The service_role key is deliberately absent. Volea never needs it: every write
# goes through RLS or a security-definer RPC as the signed-in user.
